{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "evp",
        "photo",
        "video",
        "note"
      ]
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "tour_id": {
      "type": "string"
    },
    "stop_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity_level": {
      "type": "number"
    },
    "emf_activity": {
      "type": "number"
    },
    "evp_quality": {
      "type": "number"
    },
    "personal_experience": {
      "type": "number"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "is_private": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "type"
  ]
}