{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "evp",
        "photo",
        "video",
        "note"
      ]
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "LEGACY ONLY. Permanent public URL of media saved before private storage. New evidence stores its media in media_uri instead; this field is kept so existing records still display."
    },
    "media_uri": {
      "type": "string",
      "description": "Private-storage URI of this record's media. Only ever read by the evidence-media-link function, which mints a short-lived signed viewing URL after checking the viewer's permission. Unreadable by clients.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "media_duration_seconds": {
      "type": "number",
      "description": "Actual playing time of the saved recording, in whole seconds (after any trim). Drives how long a signed viewing link lives: duration + 5 minutes, capped at the signed-URL maximum. Null for stills."
    },
    "has_media": {
      "type": "boolean",
      "default": false,
      "description": "true when this record's media is stored privately in media_uri. Lets a viewer know media exists without reading the private URI."
    },
    "tour_id": {
      "type": "string"
    },
    "stop_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity_level": {
      "type": "number"
    },
    "emf_activity": {
      "type": "number"
    },
    "evp_quality": {
      "type": "number"
    },
    "personal_experience": {
      "type": "number"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "location_source": {
      "type": "string",
      "enum": [
        "GPS",
        "TOUR_STOP",
        "MANUAL",
        "NONE"
      ],
      "description": "How the evidence location was established at save time. GPS = user's device GPS captured at save. TOUR_STOP = the viewed tour stop's coordinates (user explicitly chose this when GPS was unavailable). MANUAL = user typed an address or location name that was forward-geocoded to coordinates at save time (never device GPS). NONE = no location (private only, cannot be made public). Make Public uses the original coordinates saved with the evidence \u2014 never re-captures the user's current GPS. Historical records without this field are treated as having a valid location if latitude/longitude exist."
    },
    "is_private": {
      "type": "boolean",
      "default": false
    },
    "source_tool": {
      "type": "string",
      "description": "The toolkit tool that produced this evidence, stored as the tool's type slug (e.g. 'recorder', 'audio', 'sls', 'rem', 'environment', 'sieg', 'termbank', 'alphabet', 'yesno'). Manual saves from the Evidence page use 'photo', 'note', or 'manual' (for EVP/video uploads). Legacy records without this field are treated as manual. Used by the Community Map to filter and color markers by tool."
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_private": false
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}