{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "evp",
        "photo",
        "video",
        "note"
      ]
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "tour_id": {
      "type": "string"
    },
    "stop_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity_level": {
      "type": "number"
    },
    "emf_activity": {
      "type": "number"
    },
    "evp_quality": {
      "type": "number"
    },
    "personal_experience": {
      "type": "number"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "location_source": {
      "type": "string",
      "enum": [
        "GPS",
        "TOUR_STOP",
        "MANUAL",
        "NONE"
      ],
      "description": "How the evidence location was established at save time. GPS = user's device GPS captured at save. TOUR_STOP = the viewed tour stop's coordinates (user explicitly chose this when GPS was unavailable). MANUAL = user typed an address or location name that was forward-geocoded to coordinates at save time (never device GPS). NONE = no location (private only, cannot be made public). Make Public uses the original coordinates saved with the evidence \u2014 never re-captures the user's current GPS. Historical records without this field are treated as having a valid location if latitude/longitude exist."
    },
    "is_private": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_private": false
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}