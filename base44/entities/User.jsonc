{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "description": "User-editable display name shown on the profile. Takes precedence over the platform-managed full_name. Set by the user via the Profile page or at registration (via the set-username backend function)."
    },
    "username_lower": {
      "type": "string",
      "description": "Case-insensitive uniqueness key for display_name (lowercased + trimmed). Used by the check-username / set-username backend functions to enforce username uniqueness. Base44 does not support a unique index, so enforcement is check-and-write in a single service-role call \u2014 narrows but does not fully close the race window."
    },
    "settings": {
      "type": "string",
      "description": "JSON-encoded user settings"
    },
    "blocked_users": {
      "type": "string",
      "description": "JSON-encoded list of blocked user ids"
    },
    "plan": {
      "type": "string",
      "enum": [
        "observer",
        "seeker",
        "technician",
        "explorer",
        "investigator",
        "trailblazer"
      ],
      "default": "observer",
      "description": "Current access level. observer = free, seeker = ad-free basic, technician = ad-free + 10 tools + aura save, explorer = standard (narration + generation), investigator = premium (full toolkit + more energy), trailblazer = 30-month elite"
    },
    "manifestation_energy": {
      "type": "number",
      "default": 0,
      "description": "Monthly Manifestation Energy for AI tour/stop generation (InvokeLLM). Resets monthly. Never spent on evidence saves."
    },
    "narration_energy": {
      "type": "number",
      "default": 0,
      "description": "Monthly Narration Energy for text-to-speech (GenerateSpeech). Resets monthly. Never spent on evidence saves."
    },
    "energy_reset_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when monthly energy resets to full allocation"
    },
    "aura_manifestation_energy": {
      "type": "number",
      "default": 0,
      "description": "Rollover Manifestation Energy from Aura Bundle purchases (Explorer/Investigator/Trailblazer 20% share). Does not reset monthly. Can be spent on evidence saves after the daily free limit."
    },
    "aura_narration_energy": {
      "type": "number",
      "default": 0,
      "description": "Rollover Narration Energy from Aura Bundle purchases (Explorer/Investigator/Trailblazer 80% share). Does not reset monthly. Can be spent on evidence saves after the daily free limit."
    },
    "aura_save_energy": {
      "type": "number",
      "default": 0,
      "description": "Dedicated Save Energy pool for Technician (100% of Aura Bundle purchases). Can ONLY be spent on evidence saves after the 20 free daily saves. Cannot be used for narration or generation. Does not reset monthly."
    },
    "tool_banks": {
      "type": "string",
      "description": "JSON-encoded map of tool name to { r: remaining_seconds, e: earned_today_seconds, l: last_heartbeat_ms } for Observer ad-gated tools (Audio Recorder, Radio Sweeper). 30s ad = 30s use, 5-min (300s) daily cap per tool. Resets daily via tool_banks_date. r and e are written only by grant-tool-time (on ad watch) and consume-tool-time (on heartbeat/close) \u2014 the client never writes r directly. l is the server wall-clock timestamp set by consume-tool-time on each heartbeat and cleared on close. Only Observer (free) users use this counter; Seeker+ is ad-free."
    },
    "tool_banks_date": {
      "type": "string",
      "format": "date",
      "description": "The date (YYYY-MM-DD) for the current tool_banks counters. Used to reset daily caps at midnight."
    },
    "evidence_save_count": {
      "type": "number",
      "default": 0,
      "description": "Number of evidence saves today. Resets when evidence_save_date changes. Observer/Seeker cap = 10, Technician+ cap = 20 (then Aura energy)."
    },
    "evidence_save_date": {
      "type": "string",
      "format": "date",
      "description": "The date (YYYY-MM-DD) for the current evidence_save_count. Used to reset the daily counter."
    },
    "stop_ad_views_count": {
      "type": "number",
      "default": 0,
      "description": "Number of paranormal stop ad views today (Observer only). Resets when stop_ad_views_date changes. Capped at 10/day via grant-stop-access. Seeker+ and admins are ad-free and never increment this counter."
    },
    "stop_ad_views_date": {
      "type": "string",
      "format": "date",
      "description": "The date (YYYY-MM-DD) for the current stop_ad_views_count. Used to reset the daily counter."
    },
    "subscription_id": {
      "type": "string",
      "description": "Wix subscription contract ID. Used to match cancel/expire webhooks."
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "canceled",
        "expired"
      ],
      "default": "none"
    },
    "plan_expiration_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the current plan expires. For Trailblazer (30-month), this is 30 months from purchase. For subscriptions, updated on renewal."
    },
    "ad_rewards_count": {
      "type": "number",
      "default": 0,
      "description": "Number of rewarded ads watched today. Resets when ad_rewards_date changes."
    },
    "ad_rewards_date": {
      "type": "string",
      "format": "date",
      "description": "The date (YYYY-MM-DD) for the current ad_rewards_count. Used to reset the daily counter."
    },
    "google_trailblazer_expiration_date": {
      "type": "string",
      "format": "date-time",
      "description": "Isolated Google Play Trailblazer expiry (purchase_date + 30 calendar months). Independent of Apple/Wix plan_expiration_date."
    },
    "google_trailblazer_manifestation_energy": {
      "type": "number",
      "default": 0,
      "description": "Monthly Manifestation Energy pool for an active Google Trailblazer grant. Isolated from generic manifestation_energy."
    },
    "google_trailblazer_narration_energy": {
      "type": "number",
      "default": 0,
      "description": "Monthly Narration Energy pool for an active Google Trailblazer grant. Isolated from generic narration_energy."
    },
    "google_trailblazer_energy_reset_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the isolated Google Trailblazer monthly energy pools reset."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}