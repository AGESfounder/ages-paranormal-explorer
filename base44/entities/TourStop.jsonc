{
  "name": "TourStop",
  "type": "object",
  "properties": {
    "tour_id": {
      "type": "string"
    },
    "stop_number": {
      "type": "number"
    },
    "stop_type": {
      "type": "string",
      "enum": [
        "tour",
        "parking",
        "shuttle"
      ],
      "default": "tour",
      "description": "tour = a regular investigation stop, parking = the parking area stop (stop_number 0, shown before stop 1), shuttle = the shuttle drop-off stop (stop_number 0, shown after parking and before stop 1 \u2014 for tours where you park at a visitor center and take a shuttle to the tour start)"
    },
    "name": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "same_structure": {
      "type": "boolean",
      "default": false,
      "description": "true = this stop is a room/area/section WITHIN a single building or vessel (rooms in the Farnsworth House, decks on a ship, different areas of one cemetery). false = its own distinct building/structure on the property (separate buildings at Pennhurst, separate batteries at a fort). For area/road_trip tours, always false. When true, multiple stops at the same coordinates are legitimate stacking, not a collapse error."
    },
    "access_area": {
      "type": "string",
      "enum": [
        "interior",
        "exterior"
      ],
      "description": "Whether this stop is inside a building/enclosed structure (interior) or outside (exterior). Used to filter stops by the tour's access_type: interior_only shows only interior stops, exterior_only shows only exterior stops, exterior_interior shows all. Auto-classified from the stop name via keyword heuristic; LLM also classifies during generation."
    },
    "historical_info": {
      "type": "string"
    },
    "paranormal_info": {
      "type": "string"
    },
    "investigation_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_investigation_time": {
      "type": "string"
    },
    "construction_date": {
      "type": "string"
    },
    "famous_people": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "narration_text": {
      "type": "string"
    },
    "travel_method": {
      "type": "string",
      "enum": [
        "walking",
        "driving"
      ]
    },
    "hours_of_operation": {
      "type": "string"
    },
    "entry_fee": {
      "type": "string"
    },
    "parking_type": {
      "type": "string",
      "enum": [
        "street",
        "parking_lot",
        "parking_garage",
        "shuttle_free",
        "shuttle_paid"
      ],
      "description": "For parking stops: street = on-street parking, parking_lot = surface parking lot, parking_garage = multi-level parking structure. For shuttle stops: shuttle_free = free shuttle service, shuttle_paid = paid shuttle service."
    },
    "parking_cost": {
      "type": "string",
      "description": "For parking and shuttle stops: cost description (e.g., 'Free', 'Metered ($1.50/hr, free after 6pm)', 'Paid lot ($5 flat rate)', 'Free shuttle', '$5 round-trip shuttle')."
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "story": {
            "type": "string"
          }
        }
      }
    },
    "geocoded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the GPS coordinates have been verified via real address geocoding (Nominatim). False = LLM-generated coordinates that may be inaccurate."
    },
    "needs_placement": {
      "type": "boolean",
      "default": false,
      "description": "For large property tours (parks, forts, farms, battlefields): true when no definitive GPS coordinates could be found via Overpass or LLM web search. The stop is placed near the parking area with a pink 'Needs Placement' marker. A visitor drags it to the correct location to clear this flag and turn it blue."
    },
    "user_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether a paid user or admin has confirmed this stop's coordinates by marking their GPS location (or dragging the marker) at the actual vantage point. Separate from 'geocoded' (machine-geocoded). When all stops on a tour are user_verified, the tour's 'verified' field is set to true."
    },
    "verified_by_id": {
      "type": "string",
      "description": "User ID of the person who verified this stop's coordinates."
    },
    "verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this stop's coordinates were user-verified."
    }
  },
  "required": [
    "tour_id",
    "stop_number",
    "name"
  ]
}