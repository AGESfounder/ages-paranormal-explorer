{
  "name": "TourStop",
  "type": "object",
  "properties": {
    "tour_id": {
      "type": "string"
    },
    "stop_number": {
      "type": "number"
    },
    "stop_type": {
      "type": "string",
      "enum": [
        "tour",
        "parking"
      ],
      "default": "tour",
      "description": "tour = a regular investigation stop, parking = the parking area stop (stop_number 0, shown before stop 1)"
    },
    "name": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "same_structure": {
      "type": "boolean",
      "default": false,
      "description": "true = this stop is a room/area/section WITHIN a single building or vessel (rooms in the Farnsworth House, decks on a ship, different areas of one cemetery). false = its own distinct building/structure on the property (separate buildings at Pennhurst, separate batteries at a fort). For area/road_trip tours, always false. When true, multiple stops at the same coordinates are legitimate stacking, not a collapse error."
    },
    "historical_info": {
      "type": "string"
    },
    "paranormal_info": {
      "type": "string"
    },
    "investigation_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_investigation_time": {
      "type": "string"
    },
    "construction_date": {
      "type": "string"
    },
    "famous_people": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "narration_text": {
      "type": "string"
    },
    "travel_method": {
      "type": "string",
      "enum": [
        "walking",
        "driving"
      ]
    },
    "hours_of_operation": {
      "type": "string"
    },
    "entry_fee": {
      "type": "string"
    },
    "parking_type": {
      "type": "string",
      "enum": [
        "street",
        "parking_lot",
        "parking_garage"
      ],
      "description": "For parking stops only: street = on-street parking, parking_lot = surface parking lot, parking_garage = multi-level parking structure."
    },
    "parking_cost": {
      "type": "string",
      "description": "For parking stops only: parking cost description (e.g., 'Free', 'Metered ($1.50/hr, free after 6pm)', 'Paid lot ($5 flat rate)')."
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "story": {
            "type": "string"
          }
        }
      }
    },
    "geocoded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the GPS coordinates have been verified via real address geocoding (Nominatim). False = LLM-generated coordinates that may be inaccurate."
    },
    "user_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether a paid user or admin has confirmed this stop's coordinates by marking their GPS location (or dragging the marker) at the actual vantage point. Separate from 'geocoded' (machine-geocoded). When all stops on a tour are user_verified, the tour's 'verified' field is set to true."
    },
    "verified_by_id": {
      "type": "string",
      "description": "User ID of the person who verified this stop's coordinates."
    },
    "verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this stop's coordinates were user-verified."
    }
  },
  "required": [
    "tour_id",
    "stop_number",
    "name"
  ]
}