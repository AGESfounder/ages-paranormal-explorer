{
  "name": "Tour",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tour_category": {
      "type": "string",
      "enum": [
        "landmark",
        "area",
        "road_trip",
        "ship",
        "cold_spot"
      ],
      "description": "Tour category: property (enum value 'landmark') = single property with all stops on the same site, area = various properties in a local area with no repeat stops, road_trip = 8-10 stops with 5+ miles between most stops, ship = haunted ship or vessel with all stops on the same vessel, cold_spot = a very short tour with 1-4 stops at a single haunted location or tiny cluster"
    },
    "access_type": {
      "type": "string",
      "enum": [
        "exterior_only",
        "exterior_interior",
        "interior_only"
      ],
      "description": "Access classification for cold_spot and landmark (property) tours: exterior_only = tour covers only exterior/grounds/perimeter (free 24/7 access), exterior_interior = tour covers both interior and exterior areas (may require paid admission), interior_only = tour covers only the interior of the building. Null/undefined for area/road_trip/ship tours. An exterior-only tour and an exterior/interior tour of the same location are different tours (not duplicates)."
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "tour_type": {
      "type": "string",
      "enum": [
        "walking",
        "driving",
        "mixed"
      ]
    },
    "location_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "introduction": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "challenging"
      ]
    },
    "estimated_duration": {
      "type": "string"
    },
    "total_distance": {
      "type": "string"
    },
    "start_location_name": {
      "type": "string"
    },
    "start_latitude": {
      "type": "number"
    },
    "start_longitude": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_info": {
      "type": "string"
    },
    "best_time": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "user_reordered": {
      "type": "boolean",
      "default": false
    },
    "manual_reorder": {
      "type": "boolean",
      "default": false,
      "description": "True when a user or admin has manually reordered stops via the drag-and-drop list (not via pin validation). This is permanent \u2014 it takes precedence over proximity-based auto-reordering so the custom order is always respected, even after all stops are validated."
    },
    "rank": {
      "type": "number",
      "description": "State ranking: 1 = #1 Most Active, 2 = #2, 3 = #3. Null/undefined for unranked tours."
    },
    "stops_regenerated": {
      "type": "number",
      "default": 0,
      "description": "Validation version of the stops. 0 = unvalidated. When validation rules change, STOPS_VALIDATION_VERSION is bumped in TourDetail.jsx, and all tours with an older version are re-validated (and regenerated if non-compliant) on next view at no energy cost. Boolean true (legacy) is treated as version 1."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether all stops on this tour have been user-verified (coordinates confirmed by a paid user or admin at the actual location). When new stops are added or regenerated, this drops back to false until the new stops are verified."
    },
    "parking_name": {
      "type": "string",
      "description": "Name of the parking area for the walking cluster (e.g., 'Main Street Metered Parking', 'City Lot #3'). Null for driving-only tours."
    },
    "parking_address": {
      "type": "string",
      "description": "Complete street address of the parking area."
    },
    "parking_latitude": {
      "type": "number",
      "description": "GPS latitude of the parking spot. Located between the first and last stop of the walking cluster."
    },
    "parking_longitude": {
      "type": "number",
      "description": "GPS longitude of the parking spot."
    },
    "parking_type": {
      "type": "string",
      "enum": [
        "street",
        "parking_lot",
        "parking_garage"
      ],
      "description": "Type of parking: street = on-street parking, parking_lot = surface parking lot, parking_garage = multi-level parking structure."
    },
    "parking_cost": {
      "type": "string",
      "description": "Parking cost description (e.g., 'Free', 'Metered ($1.50/hr, free after 6pm)', 'Paid lot ($5 flat rate)')."
    },
    "parking_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether a paid user or admin has confirmed the parking spot's coordinates at the actual location."
    }
  },
  "required": [
    "title",
    "state",
    "city",
    "tour_type"
  ]
}