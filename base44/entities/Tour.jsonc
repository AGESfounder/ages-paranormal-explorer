{
  "name": "Tour",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tour_category": {
      "type": "string",
      "enum": [
        "landmark",
        "area",
        "road_trip",
        "ship",
        "cold_spot"
      ],
      "description": "Tour category: property (enum value 'landmark') = single property with all stops on the same site, area = various properties in a local area with no repeat stops, road_trip = 8-10 stops with 5+ miles between most stops, ship = haunted ship or vessel with all stops on the same vessel, cold_spot = a very short tour with 1-4 stops at a single haunted location or tiny cluster"
    },
    "access_type": {
      "type": "string",
      "enum": [
        "exterior_only",
        "exterior_interior"
      ],
      "description": "Access classification for cold_spot and landmark (property) tours: exterior_only = tour covers only exterior/grounds/perimeter (free 24/7 access), exterior_interior = tour covers both interior and exterior areas (may require paid admission). Null/undefined for area/road_trip/ship tours. An exterior-only tour and an exterior/interior tour of the same location are different tours (not duplicates)."
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "tour_type": {
      "type": "string",
      "enum": [
        "walking",
        "driving",
        "mixed"
      ]
    },
    "location_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "introduction": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "challenging"
      ]
    },
    "estimated_duration": {
      "type": "string"
    },
    "total_distance": {
      "type": "string"
    },
    "start_location_name": {
      "type": "string"
    },
    "start_latitude": {
      "type": "number"
    },
    "start_longitude": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_info": {
      "type": "string"
    },
    "best_time": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "user_reordered": {
      "type": "boolean",
      "default": false
    },
    "rank": {
      "type": "number",
      "description": "State ranking: 1 = #1 Most Active, 2 = #2, 3 = #3. Null/undefined for unranked tours."
    }
  },
  "required": [
    "title",
    "state",
    "city",
    "tour_type"
  ]
}