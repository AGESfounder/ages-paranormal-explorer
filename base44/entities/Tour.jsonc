{
  "name": "Tour",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tour_category": {
      "type": "string",
      "enum": [
        "landmark",
        "area",
        "road_trip",
        "ship",
        "cold_spot"
      ],
      "description": "Tour category: property (landmark) = one property; area = distinct properties in a local area; road_trip = spread-out locations; ship = one vessel; cold_spot = 1-4 stops at one location or tiny cluster."
    },
    "access_type": {
      "type": "string",
      "enum": [
        "exterior_only",
        "exterior_interior",
        "interior_only"
      ],
      "description": "Access classification for cold_spot and landmark tours. Different access types at the same location are different tours."
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "tour_type": {
      "type": "string",
      "enum": [
        "walking",
        "driving",
        "mixed"
      ]
    },
    "location_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "introduction": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "challenging"
      ]
    },
    "estimated_duration": {
      "type": "string"
    },
    "total_distance": {
      "type": "string"
    },
    "start_location_name": {
      "type": "string"
    },
    "start_latitude": {
      "type": "number"
    },
    "start_longitude": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_info": {
      "type": "string"
    },
    "best_time": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "user_reordered": {
      "type": "boolean",
      "default": false
    },
    "manual_reorder": {
      "type": "boolean",
      "default": false,
      "description": "Permanent user-selected stop order. Takes precedence over automatic ordering."
    },
    "rank": {
      "type": "number",
      "description": "State ranking, 1-3. Unset for unranked tours."
    },
    "stops_regenerated": {
      "type": "number",
      "default": 0,
      "description": "Last completed coordinate/route preparation version. Viewing never triggers maintenance."
    },
    "content_version": {
      "type": "number",
      "default": 0,
      "description": "Last completed stop-content prompt version. Viewing a tour does not regenerate its content."
    },
    "build_status": {
      "type": "string",
      "enum": [
        "building",
        "ready",
        "needs_review"
      ],
      "description": "Initial build completion state. Estimated or unresolved locations and interrupted builds require review; ready is not human verification."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Human-validated tour. Automated coordinate and content maintenance must not change it."
    },
    "parking_name": {
      "type": "string"
    },
    "parking_address": {
      "type": "string"
    },
    "parking_latitude": {
      "type": "number"
    },
    "parking_longitude": {
      "type": "number"
    },
    "parking_type": {
      "type": "string",
      "enum": [
        "street",
        "parking_lot",
        "parking_garage"
      ]
    },
    "parking_cost": {
      "type": "string"
    },
    "parking_verified": {
      "type": "boolean",
      "default": false
    },
    "maintenance_nonce": {
      "type": "string",
      "description": "Opaque lease id for an in-flight build or coordinate update. Never named 'token' \u2014 that word is redacted on read.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "maintenance_user_id": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "maintenance_expires_at": {
      "type": "number",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "state",
    "city",
    "tour_type"
  ]
}