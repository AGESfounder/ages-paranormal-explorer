{
  "name": "EnergyAccount",
  "type": "object",
  "description": "Server-owned energy and usage authority. The user record is a display mirror only. AI reservations debit every required pool and claim one execution token in the same conditional update.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id this account belongs to."
    },
    "narration": {
      "type": "number",
      "default": 0,
      "description": "Generic monthly narration energy."
    },
    "manifestation": {
      "type": "number",
      "default": 0,
      "description": "Generic monthly manifestation energy."
    },
    "google_narration": {
      "type": "number",
      "default": 0
    },
    "google_manifestation": {
      "type": "number",
      "default": 0
    },
    "aura_narration": {
      "type": "number",
      "default": 0
    },
    "aura_manifestation": {
      "type": "number",
      "default": 0
    },
    "aura_save": {
      "type": "number",
      "default": 0
    },
    "tool_banks": {
      "type": "string"
    },
    "tool_banks_date": {
      "type": "string"
    },
    "save_count": {
      "type": "number",
      "default": 0
    },
    "save_date": {
      "type": "string"
    },
    "save_charge": {
      "type": "object"
    },
    "ad_count": {
      "type": "number",
      "default": 0
    },
    "ad_date": {
      "type": "string"
    },
    "spend_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grant_marker": {
      "type": "string"
    },
    "seeded_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_lock": {
      "type": "object",
      "description": "Single active AI reservation: server token, request id, payload hash, exact charged pools and start time. Null when idle; refund and release require its exact token."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}