{
  "name": "RevenueCatPurchase",
  "type": "object",
  "description": "Provider-isolated ledger for RevenueCat / Google Play purchases. Do not reuse Base44Purchase (Wix-only). Also carries admin access grants (store ADMIN_GRANT) \u2014 dated rows that resolve like a purchased plan and stop counting when they expire.",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "RevenueCat event id for the latest processed event on this row. Used for event-level idempotency."
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All RevenueCat event ids already applied to this transaction (duplicate delivery safety)."
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user id resolved from RevenueCat app_user_id."
    },
    "app_user_id": {
      "type": "string",
      "description": "RevenueCat app_user_id at event time."
    },
    "original_app_user_id": {
      "type": "string",
      "description": "RevenueCat original_app_user_id when present."
    },
    "product_id": {
      "type": "string",
      "description": "Store product id, e.g. trailblazer.30month. Admin grants use admin_grant.<planId>."
    },
    "store": {
      "type": "string",
      "description": "RevenueCat store, e.g. PLAY_STORE. Admin grants use ADMIN_GRANT."
    },
    "environment": {
      "type": "string",
      "description": "SANDBOX or PRODUCTION. Admin grants use ADMIN (never cleared by the sandbox tester reset)."
    },
    "transaction_id": {
      "type": "string",
      "description": "Store transaction id. Primary idempotency key with product_id."
    },
    "original_transaction_id": {
      "type": "string",
      "description": "Original store transaction id when distinct from transaction_id."
    },
    "event_type": {
      "type": "string",
      "description": "Latest RevenueCat event type applied to this row"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time",
      "description": "Purchase timestamp from RevenueCat purchased_at_ms"
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time",
      "description": "Purchase timestamp alias for integrations that use purchased_at."
    },
    "plan_expiration_date": {
      "type": "string",
      "format": "date-time",
      "description": "App-owned expiry: purchase_date + 27 calendar months (UTC clamp). For an admin grant, the moment the granted access ends."
    },
    "expiration_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry timestamp alias for integrations that use expiration_at."
    },
    "product_name": {
      "type": "string",
      "description": "Display name for purchase history"
    },
    "amount": {
      "type": "number",
      "description": "Price amount from RevenueCat event (absolute)"
    },
    "price": {
      "type": "number",
      "description": "Price paid in the purchased currency."
    },
    "currency": {
      "type": "string",
      "description": "ISO currency code"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "active",
        "refunded",
        "expired"
      ],
      "default": "paid"
    },
    "grant_note": {
      "type": "string",
      "description": "Admin-only note explaining an access grant (contest prize, support credit, testing). Never set on store purchases."
    },
    "granted_by_id": {
      "type": "string",
      "description": "Base44 user id of the admin who created an access grant. Never set on store purchases."
    },
    "aura_narration_granted": {
      "type": "number",
      "default": 0,
      "description": "Aura narration energy granted by this purchase (recorded at grant time for exact refund clawback). Zero for non-Aura products."
    },
    "aura_manifestation_granted": {
      "type": "number",
      "default": 0,
      "description": "Aura manifestation energy granted by this purchase (recorded at grant time for exact refund clawback). Zero for non-Aura products."
    },
    "aura_save_granted": {
      "type": "number",
      "default": 0,
      "description": "Aura save energy granted by this purchase (Technician Aura bundles route 100% here). Recorded at grant time for exact refund clawback. Zero for non-Aura products and Explorer+ Aura bundles."
    }
  },
  "required": [
    "event_id",
    "user_id",
    "app_user_id",
    "product_id",
    "transaction_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}