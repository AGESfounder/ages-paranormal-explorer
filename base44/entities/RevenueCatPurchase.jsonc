{
  "name": "RevenueCatPurchase",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "RevenueCat webhook event ID (event.id). Unique per event \u2014 used for idempotency. Duplicate events (retries) are skipped."
    },
    "event_type": {
      "type": "string",
      "description": "RevenueCat event type: INITIAL_PURCHASE, NON_RENEWING_PURCHASE, CANCELLATION, RENEWAL, EXPIRATION, etc."
    },
    "app_user_id": {
      "type": "string",
      "description": "RevenueCat app_user_id \u2014 the Base44 user ID passed to RevenueCat at purchase time."
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user ID (same as app_user_id). Duplicated for direct User entity lookups."
    },
    "original_transaction_id": {
      "type": "string",
      "description": "Store-level original transaction ID. Stable across retries/renewals for the same purchase. Used to match refund events to the original purchase."
    },
    "transaction_id": {
      "type": "string",
      "description": "Store-level transaction ID for this specific event."
    },
    "product_id": {
      "type": "string",
      "description": "RevenueCat product ID. Google Play Trailblazer = 'trailblazer.30month'. Apple Trailblazer = 'com.ages.explorer.trailblazer.30month'."
    },
    "store": {
      "type": "string",
      "description": "Store source: PLAY_STORE, APP_STORE, etc."
    },
    "environment": {
      "type": "string",
      "description": "SANDBOX or PRODUCTION."
    },
    "price": {
      "type": "number",
      "description": "Price paid in the purchased currency."
    },
    "currency": {
      "type": "string",
      "description": "ISO currency code (e.g. USD)."
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the purchase was made (from event.purchased_at_ms). Used as the start of the 30-month Trailblazer access window."
    },
    "expiration_at": {
      "type": "string",
      "format": "date-time",
      "description": "When access expires = purchased_at + 30 calendar months (PLANS.trailblazer.duration_months). Empty for refund records."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "refunded",
        "expired"
      ],
      "default": "active"
    }
  },
  "required": [
    "event_id",
    "app_user_id",
    "product_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}